@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Your enrolled courses";
    var items = Model?.ToList() ?? new List<dynamic>();
}

<div style="padding:32px 40px;max-width:1100px;margin:0 auto;">
    <h1 style="font-size:26px;font-weight:700;margin-bottom:6px;">Your enrolled courses</h1>
    <p style="font-size:14px;color:#6b7280;margin-bottom:18px;">
        Here’s a quick summary of all courses you’re currently enrolled in.
    </p>

    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;">
        <div>
            <div style="font-size:12px;text-transform:uppercase;letter-spacing:.12em;color:#6b7280;">Total courses</div>
            <div style="font-size:20px;font-weight:700;">@items.Count</div>
        </div>

        <a asp-controller="Students" asp-action="Index"
           style="font-size:13px;padding:8px 14px;border-radius:999px;border:1px solid #d1d5db;text-decoration:none;color:#374151;background:#f9fafb;">
            ⬅ Back to dashboard
        </a>
    </div>

    @if (!items.Any())
    {
        <div style="background:#f9fafb;border-radius:22px;padding:20px;border:1px dashed #d1d5db;">
            <p style="font-size:14px;color:#6b7280;margin:0;">
                You haven’t enrolled in any courses yet.
                Go to <strong>Enroll in courses</strong> from your dashboard to get started.
            </p>
        </div>
    }
    else
    {
        <div style="background:#f9fafb;border-radius:26px;padding:20px 22px;box-shadow:0 16px 35px rgba(15,23,42,0.18);">
            <h3 style="font-size:18px;font-weight:700;margin-bottom:10px;">Upcoming timetable</h3>
            <p style="font-size:13px;color:#6b7280;margin-bottom:16px;">
                Sorted by start date so you can plan ahead.
            </p>

            <div style="overflow-x:auto;">
                <table style="width:100%;border-collapse:collapse;font-size:14px;">
                    <thead>
                        <tr style="border-bottom:1px solid #e5e7eb;">
                            <th style="text-align:left;padding:10px 4px;">Course</th>
                            <th style="text-align:left;padding:10px 4px;">Lecturer</th>
                            <th style="text-align:left;padding:10px 4px;">Start date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in items.OrderBy(x => (DateTime)x.StartDate))
                        {
                            <tr style="border-bottom:1px solid #f3f4f6;">
                                <td style="padding:8px 4px;">@c.CourseName</td>
                                <td style="padding:8px 4px;">@c.LecturerName</td>
                                <td style="padding:8px 4px;">@(( (DateTime)c.StartDate ).ToString("yyyy-MM-dd"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
