@{
    ViewData["Title"] = "Dashboard";
}

<div class="alert alert-light border-0 shadow-sm rounded-4">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div>
            <h5 class="mb-1">Welcome to the Student Registration Dashboard</h5>
            <p class="mb-0 text-muted small">
                Use the navigation to manage students and courses. The main UI is on the Students and Courses screens.
            </p>
        </div>
        <div>
            <a asp-controller="Students" asp-action="Index" class="btn btn-primary btn-rounded px-3 me-2">
                Go to Students
            </a>
            <a asp-controller="Courses" asp-action="Index" class="btn btn-outline-secondary btn-rounded px-3">
                Go to Courses
            </a>
        </div>
    </div>
</div>
